# Local: SQLite automatically seeded. For Docker this is overridden by Compose.
DATABASE_URL=sqlite:///./foodops.db
DEMO_SEED=true
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional: real LLM tool calls. Without this, everything works in grounded local mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# tfidf = local search, no external calls. pgvector = PostgreSQL + API embeddings.
RAG_EMBEDDINGS=tfidf
MAX_UPLOAD_MB=5
